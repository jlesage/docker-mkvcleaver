-If IniRead($ini_file, "Updates", "Auto", 1) = 1 Then
-	GUICtrlSetState($update_check, $GUI_CHECKED)
-	Local $update_me = "1"
-Else
-	GUICtrlSetState($update_not_check, $GUI_CHECKED)
-	Local $update_me = "0"
-EndIf
+; Docker: no host updates; keep auto-check disabled.
+Local $update_me = "0"
 
 If $update_me = 1 Then
 	If @Compiled Then
@@ -219,15 +207,8 @@
